# ---------------------------------------------------------------------------
# TRADING MODE — read this first
#   paper (default): baseline strategy, simulated fills only.
#   paper+         : aggressive experimental strategy, simulated fills only.
#   live           : REAL ORDERS. Only exact 'live' can send orders.
# ---------------------------------------------------------------------------
TRADING_MODE=paper
PAPER_BALANCE=100                # starting paper cash
PAPER_LATENCY_PENALTY=0.01       # $/contract charged on paper fills (adverse-move stand-in)

# PAPER+ overrides (used only when TRADING_MODE=paper+)
PAPER_PLUS_MIN_EDGE=3.0
PAPER_PLUS_MIN_DIVERGENCE=4.0
PAPER_PLUS_TRADING_WINDOW=10
PAPER_PLUS_MIN_CONTRACT_PRICE=25
PAPER_PLUS_MAX_CONTRACT_PRICE=75
PAPER_PLUS_KELLY_FRACTION=0.20
PAPER_PLUS_MAX_POSITION_SIZE=25

# Kalshi API
KALSHI_API_BASE=https://external-api.kalshi.com
KALSHI_ORDER_API=v2              # v2 = POST /portfolio/events/orders (legacy endpoint is being retired)
KALSHI_TAKER_FEE_RATE=0.07
KALSHI_FEE_MULTIPLIER=1          # confirm for KXBTC15M on your fee schedule; the bot halts if real fees drift above the model
KALSHI_API_KEY=your_api_key_here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
KALSHI_SUBACCOUNT=0                # primary account; change only if your API key uses another subaccount
KALSHI_EXCHANGE_INDEX=-1           # force ticker-based exchange-shard auto-routing

# Market Selection
SERIES_TICKER=KXBTC15M           # Series ticker (KXBTC15M for 15-min)
SLOT_DURATION=900                # Slot duration in seconds (900=15min)

# Strategy Thresholds
MIN_EDGE=5.0                     # Minimum edge % for Polymarket arbitrage
MIN_DIVERGENCE=8.0               # Minimum divergence % for directional (Binance spot) trades
TRADING_WINDOW=10                # Only trade first N minutes of each 15-min market
PROB_MODEL=gbm_point             # gbm_point (default) | settlement_avg (v3.1, Binance strike proxy) | settlement_brti (v3.3, Kalshi floor_strike + composite USD feed); opt-in
USD_REFERENCE_ENABLED=true       # composite Coinbase/Kraken/Bitstamp BTC/USD feed (BRTI proxy); market data only

# Position Sizing
MAX_POSITION_SIZE=25             # Maximum $ per trade
MAX_TOTAL_OPEN_POSITIONS=10      # Maximum concurrent positions
MAX_POSITIONS_PER_CONTRACT=2     # Maximum positions on same contract
USE_KELLY_SIZING=true            # Enable Kelly criterion sizing
KELLY_FRACTION=0.25              # Kelly fraction (0.25 = quarter Kelly, conservative)

# Supabase (for ML pipeline + Vercel deployment)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_key_here

# Vercel Cron (auto-set by Vercel)
CRON_SECRET=your_cron_secret_here

# For Vercel: encode private key as base64 instead of file path
# KALSHI_PRIVATE_KEY_BASE64=base64_encoded_pem_contents

# Risk limits (enforced in code; see agents/skills/trading/risk-manager.js)
MAX_EXPOSURE_PCT=0.5             # open + pending cost <= 50% of bankroll
SESSION_REDUCE_PCT=0.10          # realized session loss >=10%: halve sizes
SESSION_PAUSE_PCT=0.20           # >=20%: pause new entries
SESSION_PAUSE_MINUTES=15
SESSION_HARD_STOP_PCT=0.30       # >=30%: halt until restart/resume
MAX_SESSION_LOSS_USD=0           # optional absolute stop (0 = off)
MAX_CONSECUTIVE_FAILURES=5
BALANCE_FLOOR=5
MAX_SPOT_AGE_MS=5000             # directional entries need a Binance price this fresh

# Kill switches: create the file ./data/KILL (or set KILL_SWITCH_FILE), or TRADING_ENABLED=false,
# or POST /api/halt. New entries stop immediately; exits stay allowed.
TRADING_ENABLED=true

# Server (loopback only by default; remote bind requires ADMIN_TOKEN)
HOST=127.0.0.1
# ADMIN_TOKEN=change-me
PORT=3333                        # Mission Control dashboard port

# Trade-independent ML market snapshot collector (default: 5000 ms)
ML_COLLECT_INTERVAL_MS=5000

# v2.6.1 isolated forward ML PAPER HOLD simulator (never sends real orders)
ML_PAPER_ENABLED=false
ML_PAPER_STARTING_CASH=100
ML_PAPER_MIN_EDGE=0.05
ML_PAPER_MAX_CONTRACTS=1
ML_PAPER_SPECIALIST_STARTING_CASH=100
ML_PAPER_MAX_EXPOSURE=10
# v2.8.1 Model Arena: each of six simulated bots gets this bankroll.
MODEL_ARENA_STARTING_CASH=100
MODEL_ARENA_CONTRACTS=1
# v2.9.1 Baymax-5K forward PAPER lab (requires validated 5K model snapshot)
BAYMAX5K_FORWARD_ENABLED=true
BAYMAX5K_FORWARD_STARTING_CASH=100
